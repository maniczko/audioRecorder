#!/bin/sh

# Pre-commit smart lint hook
# Lints staged JS/TS and CSS files for faster commits

echo "Smart Lint - checking staged files..."

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx)$' || true)
STYLE_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(css|scss)$' || true)
FORMAT_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|css|scss|json|md|yml|yaml)$' || true)

if [ -z "$FORMAT_FILES" ]; then
  echo "No lintable or formattable files staged"
  exit 0
fi

echo "Staged files:"
echo "$FORMAT_FILES"
echo ""

if [ -n "$STAGED_FILES" ]; then
  echo "Running ESLint on staged JS/TS files..."
  npx eslint $STAGED_FILES --fix

  if [ $? -ne 0 ]; then
    echo ""
    echo "ESLint found errors in staged files"
    echo "Fix the errors and try again"
    echo ""
    echo "Files with issues:"
    git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx)$' || true
    echo ""
    echo "To fix automatically:"
    echo "  npm run lint:fix"
    echo ""
    echo "To bypass this check (not recommended):"
    echo "  git commit --no-verify"
    exit 1
  fi
fi

if [ -n "$STYLE_FILES" ]; then
  echo ""
  echo "Running Stylelint on staged CSS files..."
  npx stylelint $STYLE_FILES

  if [ $? -ne 0 ]; then
    echo ""
    echo "Stylelint found errors in staged CSS files"
    echo "Fix the errors and try again"
    echo ""
    echo "Files with issues:"
    git diff --cached --name-only --diff-filter=ACM | grep -E '\.(css|scss)$' || true
    echo ""
    echo "To fix automatically:"
    echo "  pnpm run lint:css:fix"
    exit 1
  fi
fi

echo ""
echo "Running Prettier on staged files..."
npx prettier --write $FORMAT_FILES --ignore-unknown

if [ $? -ne 0 ]; then
  echo ""
  echo "Prettier found errors in staged files"
  echo "Fix the formatting and try again"
  echo ""
  exit 1
fi

CHANGED_FILES=$(git diff --name-only $FORMAT_FILES)

if [ -n "$CHANGED_FILES" ]; then
  echo ""
  echo "Auto-fixed issues in:"
  echo "$CHANGED_FILES"
  echo ""
  echo "Staging fixed files..."
  git add $CHANGED_FILES
  echo "Fixed files staged"
fi

echo ""
echo "Smart Lint passed"
echo "All staged files are clean"
exit 0
