#!/bin/sh

# Pre-push hook - runs release guard before allowing push
# This prevents pushing code with failing critical checks

echo "Running release guard before push..."

NODE_MAJOR=$(node -p "process.versions.node.split('.')[0]" 2>/dev/null || echo "unknown")

if [ "$NODE_MAJOR" = "22" ]; then
  pnpm run test:release:guard
else
  echo "Node $NODE_MAJOR detected; VoiceLog release guard requires Node 22."
  echo "Running release guard through a temporary Node 22 + pnpm 9 toolchain..."
  npx -y -p node@22 -p pnpm@9 pnpm run test:release:guard
fi

if [ $? -ne 0 ]; then
  echo "Release guard failed! Push blocked."
  echo "Fix the failing checks and try again."
  exit 1
fi

echo "Release guard passed! Push allowed."
exit 0
